[Unit]
Description=RELOO fixed-target operational observations
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 /srv/reloo/apps/web/scripts/collect-operations.py
TimeoutStartSec=65
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
