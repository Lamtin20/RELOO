[Unit]
Description=Download, validate and atomically replace Photon Vietnam index
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=1h
StartLimitBurst=3

[Service]
Type=oneshot
ExecStart=/opt/reloo-photon/venv/bin/python /opt/reloo-photon/photon_weekly_update.py --root /srv/reloo-maps/photon
TimeoutStartSec=3h
Restart=on-failure
RestartSec=5min
UMask=0022
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/reloo-maps/photon
ProtectHome=true
