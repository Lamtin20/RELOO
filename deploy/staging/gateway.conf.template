map_hash_bucket_size 512;
map $http_apikey $uat_service_key {
 default 0;
 "${SERVICE_ROLE_KEY}" 1;
}
map $http_authorization $uat_authorization {
 default $http_authorization;
 "" "Bearer $http_apikey";
}
server {
 listen 8000;
 server_tokens off;
 access_log off;
 client_max_body_size 8m;
 resolver 127.0.0.11 valid=5s ipv6=off;
 add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
 location = /health { return 200 'reloo-uat-gateway'; }
 location /auth/v1/ {
  set $auth_backend http://auth:9999;
  rewrite ^/auth/v1/(.*)$ /$1 break;
  proxy_pass $auth_backend;
  proxy_set_header Host staging-auth.reloo.vn;
  proxy_set_header X-Forwarded-Proto https;
 }
 location /rest/v1/ {
  if ($uat_service_key = 0) { return 403; }
  set $rest_backend http://rest:3000;
  rewrite ^/rest/v1/(.*)$ /$1 break;
  proxy_pass $rest_backend;
  proxy_set_header Authorization $uat_authorization;
 }
 location /storage/v1/ {
  if ($uat_service_key = 0) { return 403; }
  set $storage_backend http://storage:5000;
  rewrite ^/storage/v1/(.*)$ /$1 break;
  proxy_pass $storage_backend;
  proxy_set_header Authorization $http_authorization;
 }
 location / { return 404; }
}
