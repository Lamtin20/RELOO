# Dedicated resource identifiers and keys only. Never copy production .env.local.
STAGING_ENV_FILE=/srv/reloo-staging/staging.env
STAGING_IMAGE=REPLACE_WITH_REGISTRY_IMAGE_AT_SHA256_DIGEST
RELOO_ENVIRONMENT=staging
APP_ORIGIN=https://staging.reloo.vn
CRM_ORIGIN=https://staging.reloo.vn
NEXT_PUBLIC_SUPABASE_URL=https://staging-auth.reloo.vn
SUPABASE_INTERNAL_URL=http://staging-gateway:8000
STAGING_RESOURCE_ID=reloo-staging-REPLACE
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_SEPARATE_STAGING_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SEPARATE_STAGING_KEY
RELOO_PRIVATE_DATA_KEY=REPLACE_WITH_SEPARATE_STAGING_KEY
RELOO_STAGING_ACCESS_USER=staging-reviewer
RELOO_STAGING_ACCESS_PASSWORD=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_24_CHARS
RELOO_STAGING_OUTBOUND_MODE=blocked
RELOO_STAGING_PAYMENT_MODE=disabled
RELOO_MEDIA_DIR=/srv/reloo-staging/media
RELOO_EVIDENCE_DIR=/srv/reloo-staging/evidence
TRUST_PROXY=false
RELOO_NEIGHBORHOOD_ENABLED=false
NEXT_TELEMETRY_DISABLED=1
# Add local sink integrations only after egress allowlisting and explicit sandbox contracts.
