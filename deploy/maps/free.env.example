# No subscription, billing or external API key. Services run only on a private Docker network.
RELOO_MAP_MODE=self-hosted
RELOO_MAP_PROVIDER_NAME=RELOO self-hosted OSM
RELOO_MAP_RESOURCE_HOSTS=maps.reloo.internal
RELOO_MAP_STYLE_URL=https://maps.reloo.internal/style.json
RELOO_MAP_GEOCODE_URL=https://maps.reloo.internal/geocode
RELOO_MAP_REVERSE_URL=https://maps.reloo.internal/reverse
RELOO_MAP_ROUTE_URL=https://maps.reloo.internal/route/v1/driving
RELOO_MAP_ATTRIBUTION=OpenStreetMap contributors (ODbL); RELOO self-hosted tiles
# Set only after preflight verifies real regional data and reviewed deployment.
RELOO_MAP_PROVIDER_APPROVED=0
RELOO_MAP_SELF_HOSTED_READY=0
# Weekly A/B mode: mount /srv/reloo-maps/photon/state read-only at /run/reloo-photon
# in EVERY backend/renderer container. Set only after initial bootstrap succeeds.
# RELOO_PHOTON_ACTIVE_STATE=/run/reloo-photon/active.json
