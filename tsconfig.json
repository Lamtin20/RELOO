{
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "incremental": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "lib/**/*",
    "scripts/**/*",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-neighborhood-test/types/**/*.ts",
    ".next-neighborhood-test/dev/types/**/*.ts",
    ".next-care-test/types/**/*.ts",
    ".next-care-test/dev/types/**/*.ts",
    ".next-analytics-test/types/**/*.ts",
    ".next-analytics-test/dev/types/**/*.ts",
    ".next-stays-test/types/**/*.ts",
    ".next-stays-test/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
