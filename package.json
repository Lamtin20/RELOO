    "@capacitor/network": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@mediapipe/tasks-vision": "^0.10.32",
    "@simplewebauthn/browser": "14.0.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.7",
    "canonicalize": "2.1.0",
    "cheerio": "^1.2.0",
    "ethers": "6.17.0",
    "hls.js": "1.7.3",
    "ipaddr.js": "^2.5.0",
    "jsqr": "1.4.0",
    "libphonenumber-js": "^1.13.15",
    "lucide": "1.24.0",
    "lucide-react": "^1.24.0",
    "maplibre-gl": "6.16.0",
    "morphicons": "1.7.1",
    "next": "16.4.2",
    "papaparse": "^5.7.0",
    "pg": "^8.22.0",
    "qrcode": "1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "robots-parser": "^3.0.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "three": "0.160.0",
    "unified": "11.0.5",
    "zxing-wasm": "3.1.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/react": "19.2.17",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "solc": "0.8.28",
    "ssh2": "1.17.0",
    "tsx": "^4.23.1"
  },
  "overrides": {
    "solc": {
      "tmp": "0.2.7"
    }
  }
