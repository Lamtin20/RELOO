{
  "name": "reloo-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "rules:check": "node scripts/verify-product-rules.mjs",
    "staging:check": "node scripts/verify-staging.mjs",
    "test:superapp": "node --test tests/superapp.test.mjs tests/staging-environment.test.mjs tests/home-discovery.test.mjs tests/mobile-navigation.test.mjs tests/auth-navigation.test.mjs",
    "stays:preview": "node scripts/stays-preview.mjs",
    "test:stays": "node --test tests/stays.test.mjs tests/stays-management.test.mjs tests/stays-api.test.mjs tests/stays-host.test.mjs",
    "rea": "node scripts/rea.mjs",
    "rea:doctor": "node scripts/rea.mjs doctor --client codex --client cursor --skill --json",
    "test:rental-care": "node --test tests/rental-care.test.mjs",
    "test:rental-care:web": "node scripts/rental-care-test.mjs",
    "test:neighborhood": "node --test tests/neighborhood.test.mjs tests/neighborhood-safety.test.mjs",
    "test:neighborhood:web": "node scripts/neighborhood-test.mjs",
    "dev": "node server.mjs",
    "dev:next": "next dev",
    "build": "next build --webpack",
    "start": "node scripts/start-production.mjs",
    "start:next": "next start",
    "lint": "eslint",
    "db:check": "node scripts/check-supabase.mjs",
    "db:migrate": "node scripts/apply-supabase-schema.mjs",
    "db:seed": "tsx scripts/seed-supabase.mjs",
    "db:tables": "node scripts/list-supabase-tables.mjs",
    "compliance:scan": "node compliance/run.mjs",
    "compliance:gate": "node compliance/run.mjs --gate --evidence=output/compliance/evidence.json",
    "compliance:check": "node compliance/check.mjs",
    "test:compliance": "node --test tests/compliance-guardian.test.mjs",
    "compliance:inventory": "node scripts/compliance-inventory.mjs",
    "test:all": "node --test tests/*.test.mjs",
    "test:vietocr": "node --test tests/vietocr-comparison.test.mjs tests/identity-preview.test.mjs tests/identity-ocr-auto.test.mjs tests/identity-qr-auto.test.mjs && python tests/vietocr_engine_test.py"
  },
  "dependencies": {
