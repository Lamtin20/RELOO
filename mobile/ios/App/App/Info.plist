    <key>NSMicrophoneUsageDescription</key><string>RELOO cần microphone khi bạn quay video giới thiệu sản phẩm.</string>
    <key>NSPhotoLibraryUsageDescription</key><string>Chọn ảnh món đồ và video bạn muốn đăng trên RELOO.</string>
    <key>NSLocationWhenInUseUsageDescription</key><string>RELOO dùng vị trí khi bạn chọn nhận diện địa chỉ hoặc tìm đồ gần mình.</string>
    <key>CFBundleURLTypes</key><array><dict><key>CFBundleURLSchemes</key><array><string>reloo</string></array><key>CFBundleURLName</key><string>vn.reloo.app.auth</string></dict></array>
